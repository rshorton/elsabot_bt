<root BTCPP_format="4" main_tree_to_execute="MainTree">
	<BehaviorTree ID="MainTree">
		<Sequence>
         <TrackAction mode="Manual" rate="0" sound_track_mode="none" turn_base="false" object_type="person" />
         
         <Delay delay_msec="2000">          
            <GetCameraFrameForVLMObjectDetectionAction base64_image="{b64_image}" image_time="{image_time}"/>
         </Delay>
         <!-- would use VLM to identify and object and return BB coords.  Those would be passed to this action: -->
         <GetSpatialCoordsForVLMDetectedObjectAction image_time="{image_time}" roi_x1="400" roi_y1="400" roi_x2="600" roi_y2="600"
                                                  roi_image_w="1000" roi_image_h="1000" output_frame_id="base_link"
                                                  x="{x}" y="{y}" z="{z}"/>
		</Sequence>
	</BehaviorTree>
</root>
